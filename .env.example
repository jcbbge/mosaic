# Copy to .env locally. Never commit .env or send a credential in chat.
# Combined workspace proxy token: wk-<id>.ws-<secret> (not an ak- deployment token).
MODAL_PROXY_TOKEN=
# Use the exact model ID in your Modal dashboard or the endpoint's /v1/models.
MODAL_MODEL=
# Shared Endpoints default; for a Dedicated Endpoint use its URL ending in /v1.
MODAL_ENDPOINT_URL=https://inference.us-west.modal.direct/v1
PORT=3153
